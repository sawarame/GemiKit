{
  "name": "gemikit",
  "version": "2.0.1",
  "description": "Google Gemini のウェブインターフェースを強化するためのブラウザ拡張機能です。",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "esbuild src/content.ts --bundle --outfile=package/js/content.js && esbuild src/options.ts --bundle --outfile=package/js/options.js && rm -rf package.zip && (cd package && zip -r ../package.zip .)",
    "generate-icons": "node scripts/generate-icons.js"
  },

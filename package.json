  },
  "homepage": "https://github.com/sawarame/package.git#readme",
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }

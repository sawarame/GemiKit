{
  "manifest_version": 3,
  "name": "Gemini Spark",
  "version": "1.0",
  "description": "Enhances the Google Gemini web interface with useful features.",
  "permissions": ["storage"],
  "options_ui": {
    "page": "public/options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["dist/content.js"]
    }
  ]
}
